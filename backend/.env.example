PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# Required for real route + Street View generation.
GOOGLE_MAPS_API_KEY=

# Optional for Google Cloud Text-to-Speech. If omitted, GOOGLE_MAPS_API_KEY is reused.
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=en-US-Wavenet-F
GOOGLE_TTS_AUDIO_ENCODING=MP3

# Required for real AI image descriptions.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-2505

# Optional prototype settings.
HEARSIGHT_USE_MOCKS=false
MAX_STAGES=30
CHECKPOINT_SPACING_METERS=50
DESCRIPTION_CONCURRENCY=2
